{
  "name": "appium-novawindows-driver",
  "version": "1.4.4",
  "description": "Appium driver for Windows",
  "keywords": [
    "appium",
    "automated testing",
    "novawindows",
    "powershell",
    "uiautomation",
    "windows"
  ],
  "bugs": {
    "url": "https://github.com/AutomateThePlanet/appium-novawindows-driver/issues"
  },
  "license": "Apache-2.0",
  "author": "Automate The Planet",
  "repository": {
    "type": "git",
    "url": "https://github.com/AutomateThePlanet/appium-novawindows-driver.git"
  },
  "main": "build/lib/driver.js",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "test": "npx vitest run",
    "test:e2e": "npx vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@appium/base-driver": "^10.1.0",
    "appium-chromedriver": "^8.2.21",
    "bezier-easing": "^2.1.0",
    "koffi": "^2.14.1",
    "xpath-analyzer": "^3.0.1"
  },
  "devDependencies": {
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "@appium/tsconfig": "^1.2.0",
    "@appium/types": "^1.1.0",
    "@types/node": "^24.8.1",
    "vitest": "^4.1.10",
    "webdriverio": "^9.0.0"
  },
  "peerDependencies": {
    "appium": "^3.0.0-rc.2"
  },
  "optionalDependencies": {
    "ffmpeg-win32-ia32": "npm:ffmpeg-static@4.1.0",
    "ffmpeg-win32-x64": "npm:ffmpeg-static@4.1.0"
  },
  "appium": {
    "driverName": "novawindows",
    "automationName": "NovaWindows",
    "platformNames": [
      "Windows"
    ],
    "mainClass": "NovaWindowsDriver"
  }
}
